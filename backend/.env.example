PORT=8080
DATABASE_URL="host=localhost user=your_user password=your_password dbname=smart_db port=5432 sslmode=disable"
JWT_SECRET="your_super_secret_key_here"
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Frontend & CORS Configuration
FRONTEND_URL="http://localhost:3000"
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001"

# Cookie Configuration (Production cross-subdomain / cross-origin auth)
# Set COOKIE_DOMAIN=".yourdomain.com" if frontend and API are on subdomains (e.g. app.domain.com and api.domain.com)
COOKIE_DOMAIN=""
# COOKIE_SAME_SITE options: lax (default), strict, none (required for cross-site third-party cookies with HTTPS)
COOKIE_SAME_SITE="lax"

